<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Name — Portfolio</title>
  <style>
    :root {
      --bg-white: #ffffff;
      --bg-offwhite: #fafafa;
      --bg-pink: #cfecf7;
      --bg-dark: #18181b;
      --border-dark: #18181b;
      --border-light: #e4e4e7;
      --text-main: #18181b;
      --text-muted: #52525b;
      --text-light: #a1a1aa;
      --accent-magenta: #ff2a85;
      --font-sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: "JetBrains Mono", "Fira Code", "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      color: var(--text-main);
      background-color: var(--bg-white);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Top Gradient Banner & Floating Nav */
    .top-atmosphere {
      position: relative;
      background:
        radial-gradient(circle at 12% 20%, rgba(207,236,247, 0.9) 0%, rgba(255, 65, 165, 0) 42%),
        radial-gradient(circle at 88% 30%, rgba(207,236,247, 0.80) 0%, rgba(255, 45, 155, 0) 45%),
        linear-gradient(180deg, #fce7f3 0%, #ffffff 100%);
      padding: 18px 20px 56px;
      border-bottom: 1px solid var(--border-light);
    }

    .nav-bar {
      max-width: 1120px;
      margin: 0 auto 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .nav-pill {
      background: var(--bg-white);
      border: 1px solid var(--border-light);
      padding: 6px 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      display: inline-flex;
      gap: 14px;
      align-items: center;
    }

    .nav-pill a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Floating Terminal Status Box */
    .status-window {
      max-width: 440px;
      margin: 0 auto;
      background: var(--bg-white);
      border: 1.5px solid var(--border-dark);
      box-shadow: 4px 4px 0px var(--border-dark);
    }

    .status-window-header {
      background: var(--bg-dark);
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 6px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      background: #4ade80;
      border-radius: 50%;
      margin-right: 6px;
    }

    .status-window-body {
      padding: 12px 14px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .mini-btn {
      border: 1px solid var(--border-light);
      background: var(--bg-offwhite);
      padding: 4px 10px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
    }

    .mini-btn:hover {
      border-color: var(--border-dark);
    }

    /* Hero Section */
    .hero-section {
      max-width: 820px;
      margin: 0 auto;
      padding: 56px 20px 68px;
      text-align: center;
    }

    .hero-kicker {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      letter-spacing: 0.04em;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .hero-kicker::before,
    .hero-kicker::after {
      content: "";
      height: 1px;
      width: 48px;
      background: var(--border-light);
    }

    .hero-title {
      font-size: clamp(2.6rem, 6vw, 4.25rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 18px;
    }

    .hero-subtitle {
      max-width: 560px;
      margin: 0 auto 28px;
      font-size: 16px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 24px;
      flex-wrap: wrap;
      font-size: 15px;
      font-weight: 600;
    }

    .hero-actions a {
      border-bottom: 1.5px solid var(--border-dark);
      padding-bottom: 2px;
    }

    .hero-actions a:hover {
      color: var(--accent-magenta);
      border-color: var(--accent-magenta);
    }

    /* Full-Bleed Pink Section (About, Photo Space, Skills & Specs) */
    .pink-band {
      background-color: var(--bg-pink);
      border-top: 1.5px solid var(--border-dark);
      border-bottom: 1.5px solid var(--border-dark);
      padding: 64px 20px;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
    }

    .band-heading {
      font-size: clamp(2.1rem, 4.5vw, 3.25rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.08;
      margin-bottom: 8px;
    }

    .band-submeta {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-main);
      margin-bottom: 32px;
    }

    /* Reference-style Black Header Spec Card */
    .spec-window {
      background: var(--bg-white);
      border: 1.5px solid var(--border-dark);
      box-shadow: 4px 4px 0px var(--border-dark);
      margin-bottom: 28px;
    }

    .spec-window-bar {
      background: var(--bg-dark);
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 8px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 200px 1fr;
    }

    /* Empty Photo Space */
    .photo-placeholder {
      border-right: 1px solid var(--border-light);
      background: repeating-linear-gradient(
        -45deg,
        #fafafa,
        #fafafa 8px,
        #f4f4f5 8px,
        #f4f4f5 16px
      );
      min-height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .spec-rows {
      display: flex;
      flex-direction: column;
    }

    .spec-row {
      display: grid;
      grid-template-columns: 140px 1fr;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-light);
      font-family: var(--font-mono);
      font-size: 12.5px;
      align-items: baseline;
      gap: 12px;
    }

    .spec-row:last-child {
      border-bottom: none;
    }

    .spec-key {
      color: var(--text-light);
      font-size: 11.5px;
    }

    .spec-val {
      color: var(--text-main);
    }

    .tag-pill {
      display: inline-block;
      border: 1px solid var(--border-light);
      background: var(--bg-offwhite);
      padding: 2px 7px;
      font-size: 11px;
      margin: 2px 4px 2px 0;
    }

    /* Code-Block Style Experience & Resume Window */
    .code-pane {
      background: #18181b;
      color: #e4e4e7;
      padding: 18px 20px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.65;
      overflow-x: auto;
    }

    .code-comment {
      color: #71717a;
    }

    .code-keyword {
      color: #f472b6;
    }

    .code-string {
      color: #fde047;
    }

    .code-prop {
      color: #93c5fd;
    }

    /* White Canvas Sections */
    .white-section {
      padding: 64px 20px;
    }

    /* Featured Work / Case Studies Grid (2x2 Bordered Box like Reference) */
    .featured-window {
      border: 1.5px solid var(--border-dark);
      background: var(--bg-white);
      margin-bottom: 56px;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .project-card {
      padding: 24px;
      border-bottom: 1px solid var(--border-light);
      border-right: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .project-card:nth-child(2n) {
      border-right: none;
    }

    .project-card:nth-last-child(-n + 2) {
      border-bottom: none;
    }

    .project-metric {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
    }

    .project-title {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 10px;
    }

    .project-desc {
      font-size: 13.5px;
      color: var(--text-muted);
      margin-bottom: 14px;
      line-height: 1.55;
    }

    .project-details {
      font-family: var(--font-mono);
      font-size: 11.5px;
      background: var(--bg-offwhite);
      border: 1px solid var(--border-light);
      padding: 10px 12px;
      margin-bottom: 16px;
    }

    .project-details p {
      margin-bottom: 4px;
    }

    .project-details p:last-child {
      margin-bottom: 0;
    }

    .project-footer {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .project-footer a {
      color: var(--text-main);
      font-weight: 600;
      text-decoration: underline;
    }

    /* Services & Offerings Directory Table (Reference Style) */
    .directory-window {
      border: 1.5px solid var(--border-dark);
      background: var(--bg-white);
      margin-bottom: 56px;
    }

    .directory-subbar {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border-light);
      font-size: 12.5px;
      color: var(--text-muted);
      background: var(--bg-offwhite);
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }

    th {
      font-family: var(--font-mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-light);
      padding: 10px 14px;
      border-bottom: 1px solid var(--border-light);
      font-weight: 600;
    }

    td {
      padding: 14px;
      border-bottom: 1px solid var(--border-light);
      vertical-align: top;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: #fafafa;
    }

    .td-title {
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
    }

    .td-desc {
      color: var(--text-muted);
      max-width: 420px;
    }

    .td-mono {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .td-link a {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-main);
      font-weight: 600;
    }

    .td-link a:hover {
      color: var(--accent-magenta);
    }

    /* Social Proof / Testimonials & Recognition */
    .proof-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .proof-item {
      padding: 20px;
      border-right: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
    }

    .proof-item:nth-child(3n) {
      border-right: none;
    }

    .proof-quote {
      font-size: 13px;
      color: var(--text-main);
      margin-bottom: 12px;
      font-style: italic;
    }

    .proof-author {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
    }

    .logos-strip {
      padding: 14px 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      background: var(--bg-offwhite);
    }

    /* Contact & Links Section */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
    }

    .contact-info {
      padding: 24px;
      border-right: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
    }

    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 12.5px;
    }

    .contact-links a {
      display: inline-flex;
      justify-content: space-between;
      padding: 8px 10px;
      border: 1px solid var(--border-light);
      background: var(--bg-offwhite);
    }

    .contact-links a:hover {
      border-color: var(--border-dark);
    }

    .contact-form {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-group label {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .form-group input,
    .form-group textarea {
      font-family: var(--font-mono);
      font-size: 12.5px;
      padding: 9px 11px;
      border: 1px solid var(--border-light);
      background: var(--bg-offwhite);
      color: var(--text-main);
      outline: none;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: var(--border-dark);
      background: var(--bg-white);
    }

    .submit-btn {
      background: var(--bg-dark);
      color: #ffffff;
      border: 1.5px solid var(--border-dark);
      padding: 10px 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      align-self: flex-start;
    }

    .submit-btn:hover {
      background: var(--accent-magenta);
      border-color: var(--accent-magenta);
    }

    footer {
      border-top: 1px solid var(--border-light);
      padding: 24px 20px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--text-muted);
    }

    @media (max-width: 768px) {
      .about-grid,
      .featured-grid,
      .proof-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .photo-placeholder {
        border-right: none;
        border-bottom: 1px solid var(--border-light);
        min-height: 180px;
      }

      .spec-row {
        grid-template-columns: 110px 1fr;
      }

      .project-card,
      .proof-item,
      .contact-info {
        border-right: none;
        border-bottom: 1px solid var(--border-light);
      }

      .project-card:last-child {
        border-bottom: none;
      }
    }
  </style>
</head>
<body>

  <!-- Top Pink Atmosphere & Floating Navigation -->
  <header class="top-atmosphere">
    <nav class="nav-bar">
      <div class="nav-pill">
        <a href="#top">tejas-arya.dev</a>
      </div>
      <div class="nav-pill">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#proof">Proof</a>
      </div>
      <div class="nav-pill">
        <a href="#contact">Contact ↗</a>
      </div>
    </nav>

    <!-- Terminal Status Card -->
    <div class="status-window">
      <div class="status-window-header">
        <span><span class="status-dot"></span>status — tejas-arya.dev</span>
        <span>v2026.1</span>
      </div>
      <div class="status-window-body">
        <span>Available for freelance &amp; full-time roles. Based in Your City.</span>
        <a href="#work" class="mini-btn">Browse &rarr;</a>
      </div>
    </div>
  </header>

  <!-- 1. HERO SECTION -->
  <section id="top" class="hero-section">
    <div class="hero-kicker">
      <span>JAVA Developer / Springboot</span>
      <span>Bangalore</span>
    </div>
    <h1 class="hero-title">Tejas Arya</h1>
    <p class="hero-subtitle">
      Your value proposition goes here—concisely stating what you build, who you help, and the measurable impact your engineering or design work delivers.
    </p>
    <div class="hero-actions">
      <a href="#work">View selected work</a>
      <a href="#contact">Book a discovery call</a>
    </div>
  </section>

  <!-- 2. ABOUT & SKILLS (Pink Band with Spec Windows) -->
  <section id="about" class="pink-band">
    <div class="container">
      <h2 class="band-heading">About, Skills &amp; Credentials.</h2>
      <p class="band-submeta">Bio, Core Stack, Education &amp; Downloadable Résumé</p>

      <!-- Spec Card 1: Profile + Empty Photo Space -->
      <div class="spec-window">
        <div class="spec-window-bar">
          <span>PROFILE // SPEC SHEET</span>
          <span>ID: 01</span>
        </div>
        <div class="about-grid">
          <!-- Intentionally empty photo space -->
          <div class="photo-placeholder" aria-label="Empty photo placeholder"></div>

          <div class="spec-rows">
            <div class="spec-row">
              <span class="spec-key">name</span>
              <span class="spec-val"><strong>Tejas Arya</strong></span>
            </div>
            <div class="spec-row">
              <span class="spec-key">bio</span>
              <span class="spec-val">
                Concise 2–3 sentence biography highlighting your background, problem-solving philosophy, and what drives your craft.
              </span>
            </div>
            <div class="spec-row">
              <span class="spec-key">education</span>
              <span class="spec-val">Your Degree / Major — Your College / University Name (Graduation Year)</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">core skills</span>
              <span class="spec-val">
                <span class="tag-pill">Skill One</span>
                <span class="tag-pill">Skill Two</span>
                <span class="tag-pill">Tool Three</span>
                <span class="tag-pill">Framework Four</span>
                <span class="tag-pill">System Five</span>
              </span>
            </div>
            <div class="spec-row">
              <span class="spec-key">résumé / cv</span>
              <span class="spec-val">
                <a href="your-resume.pdf" download style="text-decoration: underline; font-weight: 600;">[Download Résumé PDF &darr;]</a>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Spec Card 2: Experience in Code/Primitives Style -->
      <div class="spec-window" style="margin-bottom: 0;">
        <div class="spec-window-bar">
          <span>EXPERIENCE // TIMELINE</span>
          <span>3 ROLES</span>
        </div>
        <div class="spec-rows">
          <div class="spec-row">
            <span class="spec-key">2025 – present</span>
            <span class="spec-val"><strong>Your Current Role</strong> at Your Company Name — Led key deliverables and architecture.</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">2024 – 2025</span>
            <span class="spec-val"><strong>Your Previous Role</strong> at Previous Organization — Built and shipped core user features.</span>
          </div>
          <div class="spec-row">
            <span class="spec-key">2023 – 2024</span>
            <span class="spec-val"><strong>Your Internship / Lab Role</strong> at Your College / Lab — Researched and prototyped systems.</span>
          </div>
        </div>
        <div class="code-pane">
          <span class="code-comment">// Quick summary object</span><br />
          <span class="code-keyword">const</span> profile = {<br />
          &nbsp;&nbsp;<span class="code-prop">name</span>: <span class="code-string">tejas-arya</span>,<br />
          &nbsp;&nbsp;<span class="code-prop">college</span>: <span class="code-string">"Your College Name"</span>,<br />
          &nbsp;&nbsp;<span class="code-prop">degree</span>: <span class="code-string">"Your Education / Degree"</span>,<br />
          &nbsp;&nbsp;<span class="code-prop">email</span>: <span class="code-string">"youremail@domain.com"</span><br />
          };
        </div>
      </div>
    </div>
  </section>

  <!-- 3, 4, 5 & 6. FEATURED WORK, SERVICES, SOCIAL PROOF & CONTACT -->
  <main class="white-section">
    <div class="container">

      <!-- 3. FEATURED WORK / CASE STUDIES -->
      <section id="work" class="featured-window">
        <div class="spec-window-bar">
          <span>FEATURED WORK // CASE STUDIES</span>
          <span>Problem &bull; Process &bull; Role &bull; Outcome</span>
        </div>
        <div class="featured-grid">
          <article class="project-card">
            <div>
              <div class="project-metric">
                <span>&#9733; +42% Conversion Lift</span>
                <span>01</span>
              </div>
              <h3 class="project-title">Project Title One</h3>
              <p class="project-desc">
                <strong>Problem:</strong> Brief description of the user pain point or business bottleneck solved by this project.
              </p>
              <div class="project-details">
                <p><strong>Role:</strong> Your Specific Role</p>
                <p><strong>Process:</strong> Research &rarr; Architecture &rarr; Testing &rarr; Launch</p>
                <p><strong>Outcome:</strong> Measurable metric or performance gain achieved.</p>
              </div>
            </div>
            <div class="project-footer">
              <span>Tech Stack One &bull; Tech Stack Two</span>
              <a href="#">[case study &rarr;]</a>
            </div>
          </article>

          <article class="project-card">
            <div>
              <div class="project-metric">
                <span>&#9733; 60ms Latency Reduction</span>
                <span>02</span>
              </div>
              <h3 class="project-title">Project Title Two</h3>
              <p class="project-desc">
                <strong>Problem:</strong> Brief description of the technical challenge or workflow inefficiency addressed.
              </p>
